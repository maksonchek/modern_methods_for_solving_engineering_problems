@prefix : <http://example.org/ont/task3#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/ont/task3#> .

<http://example.org/ont/task3> rdf:type owl:Ontology ;
                                owl:imports <file:/F:/Magistracy_1_1/modern_engineer_methods/Labs/task3/pd_rules.ttl> ;
                                rdfs:label "Probability of Default Classification Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/ont/task3#включает
:включает rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty .


###  http://example.org/ont/task3#имеет_заемщика
:имеет_заемщика rdf:type owl:ObjectProperty .


###  http://example.org/ont/task3#обращается_к
:обращается_к rdf:type owl:ObjectProperty .


###  http://example.org/ont/task3#подает_на_программу
:подает_на_программу rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/ont/task3#имеет_credit_score
:имеет_credit_score rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Заемщик ;
                    rdfs:range xsd:integer .


###  http://example.org/ont/task3#имеет_dti_ratio
:имеет_dti_ratio rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Заемщик ;
                 rdfs:range xsd:decimal .


###  http://example.org/ont/task3#имеет_employment_status
:имеет_employment_status rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Заемщик ;
                         rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://example.org/ont/task3#ВалидныйЗапрос
:ВалидныйЗапрос rdf:type owl:Class .


###  http://example.org/ont/task3#Заемщик
:Заемщик rdf:type owl:Class .


###  http://example.org/ont/task3#ЗапросНаКредит
:ЗапросНаКредит rdf:type owl:Class .


###  http://example.org/ont/task3#КредитнаяПрограмма
:КредитнаяПрограмма rdf:type owl:Class .


###  http://example.org/ont/task3#КритерийОценки
:КритерийОценки rdf:type owl:Class .


###  http://example.org/ont/task3#ОценочныйИндикатор
:ОценочныйИндикатор rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/ont/task3#Заемщик_1
:Заемщик_1 rdf:type owl:NamedIndividual ,
                    :Заемщик ;
           :подает_на_программу :Ипотечная_программа ;
           :имеет_credit_score 780 ;
           :имеет_dti_ratio 0.25 ;
           :имеет_employment_status 2 .


###  http://example.org/ont/task3#Заемщик_2
:Заемщик_2 rdf:type owl:NamedIndividual ,
                    :Заемщик ;
           :подает_на_программу :Ипотечная_программа ;
           :имеет_credit_score 580 ;
           :имеет_dti_ratio 0.65 ;
           :имеет_employment_status 0 .


###  http://example.org/ont/task3#Запрос_1
:Запрос_1 rdf:type owl:NamedIndividual ,
                   :ЗапросНаКредит ;
          :имеет_заемщика :Заемщик_1 ;
          :обращается_к :Кредитный_скоринг .


###  http://example.org/ont/task3#Запрос_2
:Запрос_2 rdf:type owl:NamedIndividual ,
                   :ЗапросНаКредит ;
          :имеет_заемщика :Заемщик_2 ;
          :обращается_к :Кредитный_скоринг .


###  http://example.org/ont/task3#Ипотечная_программа
:Ипотечная_программа rdf:type owl:NamedIndividual ,
                              :КредитнаяПрограмма ;
                     :включает :Критерии_одобрения .


###  http://example.org/ont/task3#Кредитный_скоринг
:Кредитный_скоринг rdf:type owl:NamedIndividual ,
                            :ОценочныйИндикатор .


###  http://example.org/ont/task3#Критерии_одобрения
:Критерии_одобрения rdf:type owl:NamedIndividual ,
                             :КритерийОценки ;
                    :включает :Кредитный_скоринг .


